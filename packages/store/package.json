{
  "name": "@ghostapi/store",
  "version": "0.1.0",
  "description": "Local, file-backed persistence for GhostAPI targets, observations, operations and traces.",
  "license": "MIT",
  "author": "Jesus Antolin",
  "homepage": "https://github.com/jaf333/ghostapi#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jaf333/ghostapi.git",
    "directory": "packages/store"
  },
  "bugs": {
    "url": "https://github.com/jaf333/ghostapi/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test:unit": "vitest run",
    "test": "vitest run"
  },
  "dependencies": {
    "@ghostapi/core": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2"
  }
}
